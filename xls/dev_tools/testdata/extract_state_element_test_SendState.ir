package SendState

chan a_value_chan(bits[32], id=0, kind=streaming, ops=send_only, flow_control=ready_valid, strictness=proven_mutually_exclusive)
chan b_value_chan(bits[32], id=1, kind=streaming, ops=send_only, flow_control=ready_valid, strictness=proven_mutually_exclusive)
chan c_chan(bits[32], id=3, kind=streaming, ops=receive_only, flow_control=ready_valid, strictness=proven_mutually_exclusive)

top proc SendState(a: bits[32], b: bits[32], init={1, 1}) {
  literal.2: token = literal(value=token, id=2)
  receive.10: (token, bits[32]) = receive(literal.2, channel=c_chan, id=10)
  a: bits[32] = state_read(state_element=a, id=1)
  b: bits[32] = state_read(state_element=b, id=4)
  c: bits[32] = tuple_index(receive.10, index=1, id=11)
  add.16: bits[32] = add(a, b, id=16)
  add.17: bits[32] = add(c, a, id=17)
  a__1: token = send(literal.2, a, channel=a_value_chan, id=3)
  b__1: token = send(literal.2, b, channel=b_value_chan, id=6)
  next_value.20: () = next_value(state_element=a, value=add.16, id=20)
  next_value.21: () = next_value(state_element=b, value=add.17, id=21)
}
