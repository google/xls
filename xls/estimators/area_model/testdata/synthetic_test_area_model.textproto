# proto-file: xls/estimators/estimator_model.proto
# proto-message: xls.estimator_model.EstimatorModel
#
# Synthetic area model used to test the `area_model` Bazel macro when no
# `precomputed_proto` is provided (fitting the estimator parameters at build
# time rather than using a checked-in precomputed proto).

metric: AREA_METRIC
op_models {
  op: "kIdentity"
  estimator {
    fixed: 3
  }
}
op_models {
  op: "kParam"
  estimator {
    fixed: 0
  }
}
op_models {
  op: "kAdd"
  estimator {
    fixed: 42
  }
}
op_models {
  op: "kSub"
  estimator {
    area_regression {
      expressions {
        factor {
          source: RESULT_BIT_COUNT
        }
      }
    }
  }
}
data_points {
  operation {
    op: "kSub"
    bit_count: 8
  }
  total_area: 80
}
data_points {
  operation {
    op: "kSub"
    bit_count: 16
  }
  total_area: 160
}
data_points {
  operation {
    op: "kSub"
    bit_count: 32
  }
  total_area: 320
}
