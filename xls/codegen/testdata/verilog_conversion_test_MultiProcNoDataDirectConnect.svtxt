`include "fifo.v"

module pipelined_proc__1(
  input wire clk,
  input wire rst,
  input wire in_vld,
  input wire internal_rdy,
  output wire in_rdy,
  output wire internal_vld
);
  reg __in_valid_reg;
  reg __internal_valid_reg;
  reg p1_inputs_valid;
  wire internal_valid_inv;
  wire internal_flop_rdy;
  wire not_160;
  wire stage_outputs_valid_1;
  wire stage_outputs_ready_0;
  wire p0_stage_done;
  wire in_valid_inv;
  wire in_flop_rdy;
  wire or_181;
  assign internal_valid_inv = ~__internal_valid_reg;
  assign internal_flop_rdy = internal_rdy | internal_valid_inv;
  assign not_160 = ~p1_inputs_valid;
  assign stage_outputs_valid_1 = p1_inputs_valid & internal_flop_rdy;
  assign stage_outputs_ready_0 = not_160 | stage_outputs_valid_1;
  assign p0_stage_done = __in_valid_reg & stage_outputs_ready_0;
  assign in_valid_inv = ~__in_valid_reg;
  assign in_flop_rdy = p0_stage_done | in_valid_inv;
  assign or_181 = p0_stage_done | stage_outputs_valid_1;
  always_ff @ (posedge clk) begin
    if (rst) begin
      __in_valid_reg <= 1'h0;
      __internal_valid_reg <= 1'h0;
      p1_inputs_valid <= 1'h0;
    end else begin
      __in_valid_reg <= in_flop_rdy ? in_vld : __in_valid_reg;
      __internal_valid_reg <= internal_flop_rdy ? p1_inputs_valid : __internal_valid_reg;
      p1_inputs_valid <= or_181 ? p0_stage_done : p1_inputs_valid;
    end
  end
  assign in_rdy = in_flop_rdy;
  assign internal_vld = __internal_valid_reg;
endmodule


module proc_out(
  input wire clk,
  input wire rst,
  input wire internal_vld,
  input wire out_rdy,
  output wire internal_rdy,
  output wire out_vld
);
  reg __internal_valid_reg;
  reg __out_valid_reg;
  reg p1_inputs_valid;
  wire out_valid_inv;
  wire out_flop_rdy;
  wire not_212;
  wire stage_outputs_valid_1;
  wire stage_outputs_ready_0;
  wire p0_stage_done;
  wire internal_valid_inv;
  wire internal_flop_rdy;
  wire or_233;
  assign out_valid_inv = ~__out_valid_reg;
  assign out_flop_rdy = out_rdy | out_valid_inv;
  assign not_212 = ~p1_inputs_valid;
  assign stage_outputs_valid_1 = p1_inputs_valid & out_flop_rdy;
  assign stage_outputs_ready_0 = not_212 | stage_outputs_valid_1;
  assign p0_stage_done = __internal_valid_reg & stage_outputs_ready_0;
  assign internal_valid_inv = ~__internal_valid_reg;
  assign internal_flop_rdy = p0_stage_done | internal_valid_inv;
  assign or_233 = p0_stage_done | stage_outputs_valid_1;
  always_ff @ (posedge clk) begin
    if (rst) begin
      __internal_valid_reg <= 1'h0;
      __out_valid_reg <= 1'h0;
      p1_inputs_valid <= 1'h0;
    end else begin
      __internal_valid_reg <= internal_flop_rdy ? internal_vld : __internal_valid_reg;
      __out_valid_reg <= out_flop_rdy ? p1_inputs_valid : __out_valid_reg;
      p1_inputs_valid <= or_233 ? p0_stage_done : p1_inputs_valid;
    end
  end
  assign internal_rdy = internal_flop_rdy;
  assign out_vld = __out_valid_reg;
endmodule


module pipelined_proc(
  input wire clk,
  input wire rst,
  input wire in_vld,
  input wire out_rdy,
  output wire in_rdy,
  output wire out_vld
);
  wire instantiation_output_126;
  wire instantiation_output_130;
  wire instantiation_output_139;
  wire instantiation_output_142;
  wire instantiation_output_133;
  wire instantiation_output_136;

  // ===== Instantiations
  pipelined_proc__1 pipelined_proc__1_inst0 (
    .rst(rst),
    .in_vld(in_vld),
    .internal_rdy(instantiation_output_133),
    .in_rdy(instantiation_output_126),
    .internal_vld(instantiation_output_130),
    .clk(clk)
  );
  proc_out proc_out_inst1 (
    .rst(rst),
    .internal_vld(instantiation_output_136),
    .out_rdy(out_rdy),
    .internal_rdy(instantiation_output_139),
    .out_vld(instantiation_output_142),
    .clk(clk)
  );
  xls_nodata_fifo_wrapper #(
    .Depth(32'd0),
    .EnableBypass(1'd1),
    .RegisterPushOutputs(1'd0),
    .RegisterPopOutputs(1'd0)
  ) fifo_internal (
    .clk(clk),
    .rst(rst),
    .push_valid(instantiation_output_130),
    .pop_ready(instantiation_output_139),
    .push_ready(instantiation_output_133),
    .pop_valid(instantiation_output_136)
  );
  assign in_rdy = instantiation_output_126;
  assign out_vld = instantiation_output_142;
endmodule
