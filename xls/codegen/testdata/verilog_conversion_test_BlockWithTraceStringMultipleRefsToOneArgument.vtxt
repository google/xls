module BlockWithTraceStringMultipleRefsToOneArgument(
  input wire [127:0] arg,
  input wire cond
);
  wire [7:0] arg_unflattened[0:15];
  assign arg_unflattened[0] = arg[7:0];
  assign arg_unflattened[1] = arg[15:8];
  assign arg_unflattened[2] = arg[23:16];
  assign arg_unflattened[3] = arg[31:24];
  assign arg_unflattened[4] = arg[39:32];
  assign arg_unflattened[5] = arg[47:40];
  assign arg_unflattened[6] = arg[55:48];
  assign arg_unflattened[7] = arg[63:56];
  assign arg_unflattened[8] = arg[71:64];
  assign arg_unflattened[9] = arg[79:72];
  assign arg_unflattened[10] = arg[87:80];
  assign arg_unflattened[11] = arg[95:88];
  assign arg_unflattened[12] = arg[103:96];
  assign arg_unflattened[13] = arg[111:104];
  assign arg_unflattened[14] = arg[119:112];
  assign arg_unflattened[15] = arg[127:120];

  `ifdef SIMULATION
  always @ (*) begin
    if (cond) begin : trace
      reg [127:0] arg_unflattened_string_display_data;
      integer arg_unflattened_string_display_size;
      arg_unflattened_string_display_data = 128'h0000_0000_0000_0000_0000_0000_0000_0000;
      arg_unflattened_string_display_size = 16;
      for (integer i = 15; i >= 0; i = i - 1) begin
        if (arg_unflattened[i] == 0) begin
          arg_unflattened_string_display_size = i;
        end
      end
      for (integer i = 0; i < arg_unflattened_string_display_size; i = i + 1) begin
        arg_unflattened_string_display_data[(arg_unflattened_string_display_size - (i + 1)) * 8 +: 8] = arg_unflattened[i];
      end
      $display("first: %0s, second: %0s", arg_unflattened_string_display_data, arg_unflattened_string_display_data);
    end
  end
  `endif  // SIMULATION
endmodule
