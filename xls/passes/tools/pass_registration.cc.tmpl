// {WARNING}

{HEADERS}

#include <string>
#include <vector>

#include "absl/log/check.h"
#include "xls/common/module_initializer.h"
#include "xls/passes/optimization_pass_registry.h"

namespace xls::pass_registration {
namespace {

void InitPassRegistration() {
  CHECK_OK(RegisterOptimizationPass<{NAME}>({SHORT_NAME}));
  const std::vector<std::string> header_files = {HEADER_FILES};
  RegisterOptimizationPassInfo({SHORT_NAME}, "{NAME}", header_files);
}

}  // namespace

XLS_REGISTER_MODULE_INITIALIZER({REGISTRATION_NAME}, InitPassRegistration());

}  // namespace xls::pass_registration
