module myproc(
  input wire clk,
  input wire rst,
  input wire out_rdy,
  output wire [31:0] out,
  output wire out_vld
);
  wire instantiation_output_47;
  wire instantiation_output_49;
  wire [31:0] instantiation_output_48;
  reg [31:0] p0_tuple_index_4;
  reg [31:0] p1_add_6;
  reg __loopback_already_done_reg;
  reg __out_already_done_reg;
  reg p1_inputs_valid;
  reg p2_inputs_valid;
  wire stage_outputs_valid_2;
  wire stage_outputs_valid_1;
  wire stage_outputs_ready_1;
  wire p1_stage_done;
  wire stage_outputs_ready_0;
  wire and_182;
  wire and_183;
  wire p0_stage_done;
  wire and_128;
  wire and_130;
  wire or_135;
  wire [31:0] add_136;
  wire or_137;
  wire and_141;
  wire or_142;
  wire and_143;
  wire or_144;
  wire or_145;
  wire or_146;

  assign stage_outputs_valid_2 = p2_inputs_valid & (out_rdy | __out_already_done_reg);
  assign stage_outputs_valid_1 = p1_inputs_valid & (instantiation_output_47 | __loopback_already_done_reg);
  assign stage_outputs_ready_1 = ~p2_inputs_valid | stage_outputs_valid_2;
  assign p1_stage_done = stage_outputs_valid_1 & stage_outputs_ready_1;
  assign stage_outputs_ready_0 = ~p1_inputs_valid | p1_stage_done;
  assign and_182 = p1_inputs_valid & ~__loopback_already_done_reg;
  assign and_183 = p2_inputs_valid & ~__out_already_done_reg;
  assign p0_stage_done = instantiation_output_49 & stage_outputs_ready_0;
  assign and_128 = and_182 & instantiation_output_47;
  assign and_130 = and_183 & out_rdy;
  assign or_135 = p0_stage_done | rst;
  assign add_136 = p0_tuple_index_4 + 32'h0000_0001;
  assign or_137 = p1_stage_done | rst;
  assign and_141 = and_128 & ~p1_stage_done;
  assign or_142 = and_128 | p1_stage_done;
  assign and_143 = and_130 & ~stage_outputs_valid_2;
  assign or_144 = and_130 | stage_outputs_valid_2;
  assign or_145 = p0_stage_done | p1_stage_done;
  assign or_146 = p1_stage_done | stage_outputs_valid_2;
  always_ff @ (posedge clk) begin
    p0_tuple_index_4 <= or_135 ? instantiation_output_48 : p0_tuple_index_4;
    p1_add_6 <= or_137 ? add_136 : p1_add_6;
  end
  always_ff @ (posedge clk) begin
    if (rst) begin
      __loopback_already_done_reg <= 1'h0;
      __out_already_done_reg <= 1'h0;
      p1_inputs_valid <= 1'h0;
      p2_inputs_valid <= 1'h0;
    end else begin
      __loopback_already_done_reg <= or_142 ? and_141 : __loopback_already_done_reg;
      __out_already_done_reg <= or_144 ? and_143 : __out_already_done_reg;
      p1_inputs_valid <= or_145 ? p0_stage_done : p1_inputs_valid;
      p2_inputs_valid <= or_146 ? p1_stage_done : p2_inputs_valid;
    end
  end
  // ===== Instantiations
  xls_fifo_wrapper #(
    .Width(32'd32),
    .Depth(32'd2),
    .EnableBypass(1'd0),
    .RegisterPushOutputs(1'd1),
    .RegisterPopOutputs(1'd0)
  ) fifo_loopback (
    .clk(clk),
    .rst(rst),
    .push_data(add_136),
    .push_valid(and_182),
    .pop_ready(p0_stage_done),
    .push_ready(instantiation_output_47),
    .pop_data(instantiation_output_48),
    .pop_valid(instantiation_output_49)
  );
  assign out = p1_add_6;
  assign out_vld = and_183;
endmodule
