module myproc(
  input wire clk,
  input wire rst,
  input wire out_rdy,
  output wire [31:0] out,
  output wire out_vld
);
  wire instantiation_output_50;
  wire instantiation_output_52;
  wire [31:0] instantiation_output_51;
  reg [31:0] p0_tuple_index_4;
  reg [31:0] p1_add_6;
  reg __loopback_already_done_reg;
  reg __out_already_done_reg;
  reg p1_inputs_valid;
  reg p2_inputs_valid;
  wire active_outputs_ready_2;
  wire p2_stage_done;
  wire stage_outputs_ready_1;
  wire active_outputs_ready_1;
  wire p1_stage_done;
  wire stage_outputs_ready_0;
  wire and_126;
  wire and_128;
  wire p0_stage_done;
  wire and_135;
  wire and_137;
  wire or_142;
  wire [31:0] add_143;
  wire or_144;
  wire and_149;
  wire or_150;
  wire and_151;
  wire or_152;
  wire or_153;
  wire or_154;

  assign active_outputs_ready_2 = out_rdy | __out_already_done_reg;
  assign p2_stage_done = p2_inputs_valid & active_outputs_ready_2;
  assign stage_outputs_ready_1 = ~p2_inputs_valid | p2_stage_done;
  assign active_outputs_ready_1 = instantiation_output_50 | __loopback_already_done_reg;
  assign p1_stage_done = p1_inputs_valid & stage_outputs_ready_1 & active_outputs_ready_1;
  assign stage_outputs_ready_0 = ~p1_inputs_valid | p1_stage_done;
  assign and_126 = p1_inputs_valid & ~__loopback_already_done_reg;
  assign and_128 = p2_inputs_valid & ~__out_already_done_reg;
  assign p0_stage_done = instantiation_output_52 & stage_outputs_ready_0;
  assign and_135 = and_126 & instantiation_output_50;
  assign and_137 = and_128 & out_rdy;
  assign or_142 = p0_stage_done | rst;
  assign add_143 = p0_tuple_index_4 + 32'h0000_0001;
  assign or_144 = p1_stage_done | rst;
  assign and_149 = and_135 & ~p1_stage_done;
  assign or_150 = and_135 | p1_stage_done;
  assign and_151 = and_137 & ~p2_stage_done;
  assign or_152 = and_137 | p2_stage_done;
  assign or_153 = p0_stage_done | p1_stage_done;
  assign or_154 = p1_stage_done | p2_stage_done;
  always_ff @ (posedge clk) begin
    p0_tuple_index_4 <= or_142 ? instantiation_output_51 : p0_tuple_index_4;
    p1_add_6 <= or_144 ? add_143 : p1_add_6;
  end
  always_ff @ (posedge clk) begin
    if (rst) begin
      __loopback_already_done_reg <= 1'h0;
      __out_already_done_reg <= 1'h0;
      p1_inputs_valid <= 1'h0;
      p2_inputs_valid <= 1'h0;
    end else begin
      __loopback_already_done_reg <= or_150 ? and_149 : __loopback_already_done_reg;
      __out_already_done_reg <= or_152 ? and_151 : __out_already_done_reg;
      p1_inputs_valid <= or_153 ? p0_stage_done : p1_inputs_valid;
      p2_inputs_valid <= or_154 ? p1_stage_done : p2_inputs_valid;
    end
  end
  // ===== Instantiations
  xls_fifo_wrapper #(
    .Width(32'd32),
    .Depth(32'd2),
    .EnableBypass(1'd0),
    .RegisterPushOutputs(1'd1),
    .RegisterPopOutputs(1'd0)
  ) fifo_loopback (
    .clk(clk),
    .rst(rst),
    .push_data(add_143),
    .push_valid(and_126),
    .pop_ready(stage_outputs_ready_0),
    .push_ready(instantiation_output_50),
    .pop_data(instantiation_output_51),
    .pop_valid(instantiation_output_52)
  );
  assign out = p1_add_6;
  assign out_vld = and_128;
endmodule
