module myproc(
  input wire clk,
  input wire rst,
  input wire out_rdy,
  output wire [31:0] out,
  output wire out_vld
);
  wire instantiation_output_50;
  wire instantiation_output_52;
  wire [31:0] instantiation_output_51;
  reg [31:0] p0_tuple_index_4;
  reg [31:0] p1_add_6;
  reg __loopback_already_done_reg;
  reg p1_inputs_valid;
  reg p2_inputs_valid;
  wire p2_stage_done;
  wire stage_outputs_ready_1;
  wire active_outputs_ready_1;
  wire p1_stage_done;
  wire stage_outputs_ready_0;
  wire and_114;
  wire p0_stage_done;
  wire and_122;
  wire or_127;
  wire [31:0] add_128;
  wire or_129;
  wire and_134;
  wire or_135;
  wire or_136;
  wire or_137;

  assign p2_stage_done = p2_inputs_valid & out_rdy;
  assign stage_outputs_ready_1 = ~p2_inputs_valid | p2_stage_done;
  assign active_outputs_ready_1 = instantiation_output_50 | __loopback_already_done_reg;
  assign p1_stage_done = p1_inputs_valid & stage_outputs_ready_1 & active_outputs_ready_1;
  assign stage_outputs_ready_0 = ~p1_inputs_valid | p1_stage_done;
  assign and_114 = p1_inputs_valid & ~__loopback_already_done_reg;
  assign p0_stage_done = instantiation_output_52 & stage_outputs_ready_0;
  assign and_122 = and_114 & instantiation_output_50;
  assign or_127 = p0_stage_done | rst;
  assign add_128 = p0_tuple_index_4 + 32'h0000_0001;
  assign or_129 = p1_stage_done | rst;
  assign and_134 = and_122 & ~p1_stage_done;
  assign or_135 = and_122 | p1_stage_done;
  assign or_136 = p0_stage_done | p1_stage_done;
  assign or_137 = p1_stage_done | p2_stage_done;
  always @ (posedge clk) begin
    p0_tuple_index_4 <= or_127 ? instantiation_output_51 : p0_tuple_index_4;
    p1_add_6 <= or_129 ? add_128 : p1_add_6;
  end
  always @ (posedge clk) begin
    if (rst) begin
      __loopback_already_done_reg <= 1'h0;
      p1_inputs_valid <= 1'h0;
      p2_inputs_valid <= 1'h0;
    end else begin
      __loopback_already_done_reg <= or_135 ? and_134 : __loopback_already_done_reg;
      p1_inputs_valid <= or_136 ? p0_stage_done : p1_inputs_valid;
      p2_inputs_valid <= or_137 ? p1_stage_done : p2_inputs_valid;
    end
  end
  // ===== Instantiations
  xls_fifo_wrapper #(
    .Width(32'd32),
    .Depth(32'd2),
    .EnableBypass(1'd0),
    .RegisterPushOutputs(1'd1),
    .RegisterPopOutputs(1'd0)
  ) fifo_loopback (
    .clk(clk),
    .rst(rst),
    .push_data(add_128),
    .push_valid(and_114),
    .pop_ready(p0_stage_done),
    .push_ready(instantiation_output_50),
    .pop_data(instantiation_output_51),
    .pop_valid(instantiation_output_52)
  );
  assign out = p1_add_6;
  assign out_vld = p2_inputs_valid;
endmodule
