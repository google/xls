module myleaf(
  input wire [31:0] in,
  input wire in_vld,
  input wire out_rdy,
  output wire in_rdy,
  output wire [31:0] out,
  output wire out_vld
);
  wire [31:0] add_42;
  assign add_42 = in + 32'h0000_0001;
  assign in_rdy = out_rdy;
  assign out = add_42;
  assign out_vld = in_vld;
endmodule
