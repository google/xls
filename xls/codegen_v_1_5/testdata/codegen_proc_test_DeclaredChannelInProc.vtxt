`include "fifo.v"

module leaf_proc(
  input wire clk,
  input wire rst,
  input wire [31:0] accum_in,
  input wire accum_in_vld,
  input wire accum_out_rdy,
  output wire accum_in_rdy,
  output wire [31:0] accum_out,
  output wire accum_out_vld
);
  reg [31:0] p0_tuple_index_5;
  reg [31:0] __accum;
  reg p1_inputs_valid;
  wire p1_stage_done;
  wire stage_outputs_ready_0;
  wire p0_stage_done;
  wire or_130;
  wire [31:0] add_131;
  wire or_134;
  assign p1_stage_done = p1_inputs_valid & accum_out_rdy;
  assign stage_outputs_ready_0 = ~p1_inputs_valid | p1_stage_done;
  assign p0_stage_done = accum_in_vld & stage_outputs_ready_0;
  assign or_130 = p0_stage_done | rst;
  assign add_131 = __accum + p0_tuple_index_5;
  assign or_134 = p0_stage_done | p1_stage_done;
  always @ (posedge clk) begin
    p0_tuple_index_5 <= or_130 ? accum_in : p0_tuple_index_5;
  end
  always @ (posedge clk) begin
    if (rst) begin
      __accum <= 32'h0000_0000;
      p1_inputs_valid <= 1'h0;
    end else begin
      __accum <= p1_stage_done ? add_131 : __accum;
      p1_inputs_valid <= or_134 ? p0_stage_done : p1_inputs_valid;
    end
  end
  assign accum_in_rdy = p0_stage_done;
  assign accum_out = add_131;
  assign accum_out_vld = p1_inputs_valid;
endmodule


module a_top_proc(
  input wire clk,
  input wire rst,
  input wire [31:0] in_ch,
  input wire in_ch_vld,
  input wire out_ch_rdy,
  output wire in_ch_rdy,
  output wire [31:0] out_ch,
  output wire out_ch_vld
);
  wire instantiation_output_74;
  wire [31:0] instantiation_output_75;
  wire instantiation_output_76;
  wire instantiation_output_94;
  wire [31:0] instantiation_output_95;
  wire instantiation_output_96;
  wire [31:0] instantiation_output_102;
  wire instantiation_output_103;
  wire instantiation_output_101;

  // ===== Instantiations
  xls_fifo_wrapper #(
    .Width(32'd32),
    .Depth(32'd1),
    .EnableBypass(1'd0),
    .RegisterPushOutputs(1'd1),
    .RegisterPopOutputs(1'd0)
  ) fifo_middle_ch (
    .clk(clk),
    .rst(rst),
    .push_data(instantiation_output_95),
    .push_valid(instantiation_output_96),
    .pop_ready(instantiation_output_101),
    .push_ready(instantiation_output_74),
    .pop_data(instantiation_output_75),
    .pop_valid(instantiation_output_76)
  );
  leaf_proc inst0 (
    .rst(rst),
    .accum_in(in_ch),
    .accum_in_vld(in_ch_vld),
    .accum_out_rdy(instantiation_output_74),
    .accum_in_rdy(instantiation_output_94),
    .accum_out(instantiation_output_95),
    .accum_out_vld(instantiation_output_96),
    .clk(clk)
  );
  leaf_proc inst1 (
    .rst(rst),
    .accum_in(instantiation_output_75),
    .accum_in_vld(instantiation_output_76),
    .accum_out_rdy(out_ch_rdy),
    .accum_out(instantiation_output_102),
    .accum_out_vld(instantiation_output_103),
    .accum_in_rdy(instantiation_output_101),
    .clk(clk)
  );
  assign in_ch_rdy = instantiation_output_94;
  assign out_ch = instantiation_output_102;
  assign out_ch_vld = instantiation_output_103;
endmodule
