module merge_outputs_proc(
  input wire clk,
  input wire rst,
  input wire [31:0] in,
  input wire in_vld,
  input wire out0_rdy,
  input wire out1_rdy,
  output wire in_rdy,
  output wire [31:0] out0,
  output wire out0_vld,
  output wire out1_vld
);
  reg __out0_already_done_reg;
  reg __out1_already_done_reg;
  reg p1_inputs_valid;
  wire and_89;
  wire stage_outputs_valid_0;
  wire and_91;
  wire and_94;
  wire and_96;
  wire and_100;
  wire or_101;
  wire and_103;
  wire or_104;
  wire or_105;
  assign and_89 = in_vld & ~__out0_already_done_reg;
  assign stage_outputs_valid_0 = in_vld & (out0_rdy | __out0_already_done_reg) & (out1_rdy | __out1_already_done_reg);
  assign and_91 = in_vld & ~__out1_already_done_reg;
  assign and_94 = and_89 & out0_rdy;
  assign and_96 = and_91 & out1_rdy;
  assign and_100 = and_94 & ~stage_outputs_valid_0;
  assign or_101 = and_94 | stage_outputs_valid_0;
  assign and_103 = and_96 & ~stage_outputs_valid_0;
  assign or_104 = and_96 | stage_outputs_valid_0;
  assign or_105 = stage_outputs_valid_0 | p1_inputs_valid;
  always_ff @ (posedge clk) begin
    if (rst) begin
      __out0_already_done_reg <= 1'h0;
      __out1_already_done_reg <= 1'h0;
      p1_inputs_valid <= 1'h0;
    end else begin
      __out0_already_done_reg <= or_101 ? and_100 : __out0_already_done_reg;
      __out1_already_done_reg <= or_104 ? and_103 : __out1_already_done_reg;
      p1_inputs_valid <= or_105 ? stage_outputs_valid_0 : p1_inputs_valid;
    end
  end
  assign in_rdy = stage_outputs_valid_0;
  assign out0 = in;
  assign out0_vld = and_89;
  assign out1_vld = and_91;
endmodule
