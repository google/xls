module ii_greater_than_one(
  input wire clk,
  input wire rst,
  input wire [31:0] in,
  input wire in_vld,
  input wire in_out_rdy,
  input wire out_rdy,
  output wire in_rdy,
  output wire [31:0] in_out,
  output wire in_out_vld,
  output wire [31:0] out,
  output wire out_vld
);
  reg [31:0] __st;
  reg __st_full;
  reg __in_out_already_done_reg;
  reg __out_already_done_reg;
  reg [31:0] __in_reg;
  reg __in_valid_reg;
  reg [31:0] __in_out_reg;
  reg __in_out_valid_reg;
  reg [31:0] __out_reg;
  reg __out_valid_reg;
  reg p1_inputs_valid;
  wire in_out_valid_inv;
  wire out_valid_inv;
  wire in_out_flop_rdy;
  wire out_flop_rdy;
  wire stage_outputs_valid_1;
  wire stage_outputs_valid_0;
  wire stage_outputs_ready_0;
  wire __in_out_vld_buf;
  wire __out_vld_buf;
  wire p0_stage_done;
  wire in_valid_inv;
  wire in_out_load_en;
  wire out_load_en;
  wire in_flop_rdy;
  wire or_1164;
  wire and_1167;
  wire or_1168;
  wire and_1169;
  wire or_1170;
  wire in_load_en;
  assign in_out_valid_inv = ~__in_out_valid_reg;
  assign out_valid_inv = ~__out_valid_reg;
  assign in_out_flop_rdy = in_out_rdy | in_out_valid_inv;
  assign out_flop_rdy = out_rdy | out_valid_inv;
  assign stage_outputs_valid_1 = p1_inputs_valid & __in_valid_reg & (in_out_flop_rdy | __in_out_already_done_reg);
  assign stage_outputs_valid_0 = __st_full & (out_flop_rdy | __out_already_done_reg);
  assign stage_outputs_ready_0 = ~p1_inputs_valid | stage_outputs_valid_1;
  assign __in_out_vld_buf = p1_inputs_valid & __in_valid_reg & ~__in_out_already_done_reg;
  assign __out_vld_buf = __st_full & ~__out_already_done_reg;
  assign p0_stage_done = stage_outputs_valid_0 & stage_outputs_ready_0;
  assign in_valid_inv = ~__in_valid_reg;
  assign in_out_load_en = __in_out_vld_buf & in_out_flop_rdy;
  assign out_load_en = __out_vld_buf & out_flop_rdy;
  assign in_flop_rdy = stage_outputs_valid_1 | in_valid_inv;
  assign or_1164 = p0_stage_done | stage_outputs_valid_1;
  assign and_1167 = in_out_load_en & ~stage_outputs_valid_1;
  assign or_1168 = in_out_load_en | stage_outputs_valid_1;
  assign and_1169 = out_load_en & ~p0_stage_done;
  assign or_1170 = out_load_en | p0_stage_done;
  assign in_load_en = in_vld & in_flop_rdy;
  always @ (posedge clk) begin
    if (rst) begin
      __st <= 32'h0000_0000;
      __st_full <= 1'h1;
      __in_out_already_done_reg <= 1'h0;
      __out_already_done_reg <= 1'h0;
      __in_reg <= 32'h0000_0000;
      __in_valid_reg <= 1'h0;
      __in_out_reg <= 32'h0000_0000;
      __in_out_valid_reg <= 1'h0;
      __out_reg <= 32'h0000_0000;
      __out_valid_reg <= 1'h0;
      p1_inputs_valid <= 1'h0;
    end else begin
      __st <= stage_outputs_valid_1 ? __in_reg : __st;
      __st_full <= or_1164 ? stage_outputs_valid_1 : __st_full;
      __in_out_already_done_reg <= or_1168 ? and_1167 : __in_out_already_done_reg;
      __out_already_done_reg <= or_1170 ? and_1169 : __out_already_done_reg;
      __in_reg <= in_load_en ? in : __in_reg;
      __in_valid_reg <= in_flop_rdy ? in_vld : __in_valid_reg;
      __in_out_reg <= in_out_load_en ? __in_reg : __in_out_reg;
      __in_out_valid_reg <= in_out_flop_rdy ? __in_out_vld_buf : __in_out_valid_reg;
      __out_reg <= out_load_en ? __st : __out_reg;
      __out_valid_reg <= out_flop_rdy ? __out_vld_buf : __out_valid_reg;
      p1_inputs_valid <= or_1164 ? p0_stage_done : p1_inputs_valid;
    end
  end
  assign in_rdy = in_flop_rdy;
  assign in_out = __in_out_reg;
  assign in_out_vld = __in_out_valid_reg;
  assign out = __out_reg;
  assign out_vld = __out_valid_reg;
endmodule
