module merge_outputs_proc(
  input wire clk,
  input wire rst,
  input wire [31:0] in,
  input wire in_vld,
  output wire in_rdy,
  output wire [31:0] out0,
  output wire out0_vld,
  output wire out1_vld
);
  reg p1_inputs_valid;
  wire or_64;
  assign or_64 = in_vld | p1_inputs_valid;
  always @ (posedge clk) begin
    if (rst) begin
      p1_inputs_valid <= 1'h0;
    end else begin
      p1_inputs_valid <= or_64 ? in_vld : p1_inputs_valid;
    end
  end
  assign in_rdy = in_vld;
  assign out0 = in;
  assign out0_vld = in_vld;
  assign out1_vld = in_vld;
endmodule
