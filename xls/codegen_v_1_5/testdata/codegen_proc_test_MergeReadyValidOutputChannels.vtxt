module merge_outputs_proc(
  input wire clk,
  input wire rst,
  input wire [31:0] in,
  input wire in_vld,
  input wire out0_rdy,
  input wire out1_rdy,
  output wire in_rdy,
  output wire [31:0] out0,
  output wire out0_vld,
  output wire out1_vld
);
  reg __out0_already_done_reg;
  reg __out1_already_done_reg;
  reg p1_inputs_valid;
  wire active_outputs_ready_0;
  wire and_94;
  wire p0_stage_done;
  wire and_96;
  wire and_99;
  wire and_101;
  wire and_105;
  wire or_106;
  wire and_108;
  wire or_109;
  wire or_110;
  assign active_outputs_ready_0 = (out0_rdy | __out0_already_done_reg) & (out1_rdy | __out1_already_done_reg);
  assign and_94 = in_vld & ~__out0_already_done_reg;
  assign p0_stage_done = in_vld & active_outputs_ready_0;
  assign and_96 = in_vld & ~__out1_already_done_reg;
  assign and_99 = and_94 & out0_rdy;
  assign and_101 = and_96 & out1_rdy;
  assign and_105 = and_99 & ~p0_stage_done;
  assign or_106 = and_99 | p0_stage_done;
  assign and_108 = and_101 & ~p0_stage_done;
  assign or_109 = and_101 | p0_stage_done;
  assign or_110 = p0_stage_done | p1_inputs_valid;
  always @ (posedge clk) begin
    if (rst) begin
      __out0_already_done_reg <= 1'h0;
      __out1_already_done_reg <= 1'h0;
      p1_inputs_valid <= 1'h0;
    end else begin
      __out0_already_done_reg <= or_106 ? and_105 : __out0_already_done_reg;
      __out1_already_done_reg <= or_109 ? and_108 : __out1_already_done_reg;
      p1_inputs_valid <= or_110 ? p0_stage_done : p1_inputs_valid;
    end
  end
  assign in_rdy = p0_stage_done;
  assign out0 = in;
  assign out0_vld = and_94;
  assign out1_vld = and_96;
endmodule
