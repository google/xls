module leaf_proc(
  input wire clk,
  input wire rst,
  input wire [31:0] accum_in,
  input wire accum_in_vld,
  input wire accum_out_rdy,
  output wire accum_in_rdy,
  output wire [31:0] accum_out,
  output wire accum_out_vld
);
  reg [31:0] p0_tuple_index_5;
  reg [31:0] __accum;
  reg p1_inputs_valid;
  wire p1_stage_done;
  wire stage_outputs_ready_0;
  wire p0_stage_done;
  wire or_131;
  wire [31:0] add_132;
  wire or_135;
  assign p1_stage_done = p1_inputs_valid & accum_out_rdy;
  assign stage_outputs_ready_0 = ~p1_inputs_valid | p1_stage_done;
  assign p0_stage_done = accum_in_vld & stage_outputs_ready_0;
  assign or_131 = p0_stage_done | rst;
  assign add_132 = __accum + p0_tuple_index_5;
  assign or_135 = p0_stage_done | p1_stage_done;
  always_ff @ (posedge clk) begin
    p0_tuple_index_5 <= or_131 ? accum_in : p0_tuple_index_5;
  end
  always_ff @ (posedge clk) begin
    if (rst) begin
      __accum <= 32'h0000_0000;
      p1_inputs_valid <= 1'h0;
    end else begin
      __accum <= p1_stage_done ? add_132 : __accum;
      p1_inputs_valid <= or_135 ? p0_stage_done : p1_inputs_valid;
    end
  end
  assign accum_in_rdy = p0_stage_done;
  assign accum_out = add_132;
  assign accum_out_vld = p1_inputs_valid;
endmodule


module a_top_proc(
  input wire clk,
  input wire rst,
  input wire [31:0] in0_ch,
  input wire in0_ch_vld,
  input wire [31:0] in1_ch,
  input wire in1_ch_vld,
  input wire out0_ch_rdy,
  input wire out1_ch_rdy,
  output wire in0_ch_rdy,
  output wire in1_ch_rdy,
  output wire [31:0] out0_ch,
  output wire out0_ch_vld,
  output wire [31:0] out1_ch,
  output wire out1_ch_vld
);
  wire instantiation_output_95;
  wire [31:0] instantiation_output_96;
  wire instantiation_output_97;
  wire instantiation_output_102;
  wire [31:0] instantiation_output_103;
  wire instantiation_output_104;

  // ===== Instantiations
  leaf_proc inst0 (
    .rst(rst),
    .accum_in(in0_ch),
    .accum_in_vld(in0_ch_vld),
    .accum_out_rdy(out0_ch_rdy),
    .accum_in_rdy(instantiation_output_95),
    .accum_out(instantiation_output_96),
    .accum_out_vld(instantiation_output_97),
    .clk(clk)
  );
  leaf_proc inst1 (
    .rst(rst),
    .accum_in(in1_ch),
    .accum_in_vld(in1_ch_vld),
    .accum_out_rdy(out1_ch_rdy),
    .accum_in_rdy(instantiation_output_102),
    .accum_out(instantiation_output_103),
    .accum_out_vld(instantiation_output_104),
    .clk(clk)
  );
  assign in0_ch_rdy = instantiation_output_95;
  assign in1_ch_rdy = instantiation_output_102;
  assign out0_ch = instantiation_output_96;
  assign out0_ch_vld = instantiation_output_97;
  assign out1_ch = instantiation_output_103;
  assign out1_ch_vld = instantiation_output_104;
endmodule
