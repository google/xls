module merge_outputs_proc(
  input wire clk,
  input wire rst,
  input wire [31:0] in,
  input wire in_vld,
  output wire in_rdy,
  output wire [31:0] out0,
  output wire out0_vld,
  output wire out1_vld
);
  reg __out0_already_done_reg;
  reg __out1_already_done_reg;
  reg p1_inputs_valid;
  wire and_77;
  wire and_79;
  wire and_86;
  wire or_87;
  wire and_89;
  wire or_90;
  wire or_91;
  assign and_77 = in_vld & ~__out0_already_done_reg;
  assign and_79 = in_vld & ~__out1_already_done_reg;
  assign and_86 = and_77 & ~in_vld;
  assign or_87 = and_77 | in_vld;
  assign and_89 = and_79 & ~in_vld;
  assign or_90 = and_79 | in_vld;
  assign or_91 = in_vld | p1_inputs_valid;
  always_ff @ (posedge clk) begin
    if (rst) begin
      __out0_already_done_reg <= 1'h0;
      __out1_already_done_reg <= 1'h0;
      p1_inputs_valid <= 1'h0;
    end else begin
      __out0_already_done_reg <= or_87 ? and_86 : __out0_already_done_reg;
      __out1_already_done_reg <= or_90 ? and_89 : __out1_already_done_reg;
      p1_inputs_valid <= or_91 ? in_vld : p1_inputs_valid;
    end
  end
  assign in_rdy = in_vld;
  assign out0 = in;
  assign out0_vld = and_77;
  assign out1_vld = and_79;
endmodule
