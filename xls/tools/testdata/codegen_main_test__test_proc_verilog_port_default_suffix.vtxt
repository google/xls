module neg_proc(
  input wire [31:0] in,
  input wire in_vld,
  input wire out_rdy,
  output wire in_rdy,
  output wire [31:0] out,
  output wire out_vld
);
  wire p0_stage_done;
  wire [31:0] negate;
  assign p0_stage_done = in_vld & out_rdy;
  assign negate = -in;
  assign in_rdy = p0_stage_done;
  assign out = negate;
  assign out_vld = in_vld;
endmodule
